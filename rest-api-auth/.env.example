# Port the HTTP server listens on
PORT=3001

# Secret used to sign JSON Web Tokens. Use a long, random string in production.
JWT_SECRET=change-this-to-a-long-random-secret

# How long access tokens remain valid (jsonwebtoken "expiresIn" format)
JWT_EXPIRES_IN=1h

# Number of bcrypt salt rounds used when hashing passwords
BCRYPT_SALT_ROUNDS=10
